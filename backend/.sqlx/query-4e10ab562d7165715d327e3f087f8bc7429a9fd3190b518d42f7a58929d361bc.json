{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            p.*,\n            COALESCE(\n                (\n                    SELECT json_agg(\n                        json_build_object(\n                            'move_name', km.move_name,\n                            'learn_method', km.learn_method\n                        )\n                    )\n                    FROM key_moves km\n                    WHERE (km.pokedex_id, km.form, km.patch_version) =\n                        (p.pokedex_id, p.form, p.patch_version)\n                ),\n                '[]'::json\n            ) as \"key_moves!: Json<Vec<KeyMoveRow>>\"\n        FROM pokemon p\n        ",
